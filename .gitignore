# Ignore directories generated by Composer
/drush/contrib/
/drush/Commands/contrib/
/vendor/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/web/libraries/

# Ignore sensitive information
# Only ignore default settings.php (DDEV auto-generates it).
# Additional multisite settings.php files (e.g. sites/unsdg) are tracked in git.
/web/sites/default/settings.php
/web/sites/*/settings.local.php

# Ignore Drupal's file directory
/web/sites/*/files/

# Ignore SimpleTest multi-site environment.
/web/sites/simpletest

# Ignore files generated by PhpStorm
/.idea/

# Ignore .env files as they are personal
/.env

*.sql

# Ignore OS generated files
.DS_Store

# Ignore CTags files
tags

# Ignore unencrypted deploy key
.undg_ims_deploy_key
/.editorconfig
/.gitattributes

unct.es.secrets.json

# PHPUnit temporary file
# @see https://stackoverflow.com/questions/55091768/what-is-phpunit-result-cache
.phpunit.result.cache

poeditor.log

# Patching leftover.
*.orig
*.rej

# Azure build process.
.docker_build
Dockerfile

.ddev/commands/web/az*
.ddev/commands/web/files*
.ddev/commands/host/az*

deployed_version

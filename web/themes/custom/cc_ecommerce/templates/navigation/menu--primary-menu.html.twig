{#
/**
 * @file
 * Theme override for the primary menu.
 */
#}
{% import _self as menus %}
{{ attach_library('cc_ecommerce/navigation') }}

<button class="cc-hamburger" aria-label="{{ 'Toggle navigation'|t }}" aria-expanded="false" aria-controls="cc-nav-mobile">
  <span class="cc-hamburger__bar"></span>
  <span class="cc-hamburger__bar"></span>
  <span class="cc-hamburger__bar"></span>
</button>

<nav class="cc-nav" aria-label="{{ 'Main navigation'|t }}">
  <ul class="cc-nav__list">
    {% for item in items %}
      <li class="cc-nav__item{% if item.is_expanded %} cc-nav__item--has-children{% endif %}">
        <a href="{{ item.url }}" class="cc-nav__link{% if item.in_active_trail %} cc-nav__link--active{% endif %}">
          {{ item.title }}
        </a>
        {% if item.below %}
          <ul class="cc-nav__dropdown">
            {% for child in item.below %}
              <li><a href="{{ child.url }}" class="cc-nav__link">{{ child.title }}</a></li>
            {% endfor %}
          </ul>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
</nav>

<nav class="cc-nav-mobile" id="cc-nav-mobile" aria-label="{{ 'Mobile navigation'|t }}">
  <ul class="cc-nav-mobile__list">
    {% for item in items %}
      <li><a href="{{ item.url }}" class="cc-nav-mobile__link">{{ item.title }}</a></li>
    {% endfor %}
  </ul>
</nav>

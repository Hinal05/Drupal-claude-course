{#
/**
 * @file
 * Theme override for the sidebar_first / sidebar_second regions.
 *
 * Generic sidebar for supplementary content on category/product listing
 * pages — e.g. filters, categories, promotional blocks. This template is
 * used for both sidebars via hook_theme_suggestions_region_alter().
 *
 * Available variables:
 * - content: The content for this region, typically blocks.
 */
#}
{{ attach_library('cc_ecommerce/sidebar') }}
{% if content %}
  <aside class="cc-sidebar" role="complementary">
    <div class="cc-sidebar__inner">
      {{ content }}
    </div>
  </aside>
{% endif %}

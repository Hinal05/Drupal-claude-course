{#
/**
 * @file
 * Theme override for product node in full view.
 */
#}
{{ attach_library('cc_ecommerce/product-detail') }}
<article{{ attributes.addClass('cc-product-detail') }}>
  <div class="cc-product-detail__inner">
    <div class="cc-product-detail__gallery">
      {% if content.field_image %}
        <div class="cc-product-detail__gallery-main">
          {{ content.field_image }}
        </div>
      {% endif %}
    </div>
    <div class="cc-product-detail__info">
      <h1 class="cc-product-detail__title">{{ label }}</h1>
      {% if content.field_price %}
        <div class="cc-product-detail__price">{{ content.field_price }}</div>
      {% endif %}
      {% if content.body %}
        <div class="cc-product-detail__description">
          {{ content.body }}
        </div>
      {% endif %}
      <a href="#" class="cc-product-detail__cta">{{ 'Add to Cart'|t }}</a>
    </div>
  </div>
</article>

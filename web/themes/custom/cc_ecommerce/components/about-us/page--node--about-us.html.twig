{#
/**
 * @file
 * Theme override for About Us page.
 */
#}
{{ attach_library('cc_ecommerce/about-us') }}
<!DOCTYPE html>
<html{{ html_attributes }}>
  <head>
    <head-placeholder token="{{ placeholder_token }}">
    <title>{{ head_title|safe_join(' | ') }}</title>
    <css-placeholder token="{{ placeholder_token }}">
    <js-placeholder token="{{ placeholder_token }}">
  </head>
  <body{{ attributes }}>
    <a href="#main-content" class="skip-link">{{ 'Skip to main content'|t }}</a>
    {{ page_top }}
    <div class="layout-container">
      {{ page.header }}
      {{ page.primary_menu }}
    </div>

    <div class="cc-hero"{% if hero_image_url %} style="background-image: url('{{ hero_image_url }}')"{% endif %}>
      {% if hero_image_url %}
        <div class="cc-hero__bg" style="background-image: url('{{ hero_image_url }}')"></div>
      {% endif %}
      <div class="cc-hero__content">
        <h1 class="cc-hero__title">{{ 'About Us'|t }}</h1>
        <p class="cc-hero__subtitle">{{ 'Passionate people building great products.'|t }}</p>
      </div>
    </div>

    <main id="main-content" class="cc-about">
      <div class="cc-about__grid">
        <div class="cc-about__body">
          {{ page.content }}
        </div>
        <aside class="cc-about__sidebar">
          <div class="cc-about__stat">
            <div class="cc-about__stat-number">10+</div>
            <div class="cc-about__stat-label">{{ 'Years Experience'|t }}</div>
          </div>
          <div class="cc-about__stat">
            <div class="cc-about__stat-number">500+</div>
            <div class="cc-about__stat-label">{{ 'Happy Customers'|t }}</div>
          </div>
          <div class="cc-about__stat">
            <div class="cc-about__stat-number">50+</div>
            <div class="cc-about__stat-label">{{ 'Products'|t }}</div>
          </div>
        </aside>
      </div>
    </main>

    {{ page_bottom }}
    <js-bottom-placeholder token="{{ placeholder_token }}">
  </body>
</html>

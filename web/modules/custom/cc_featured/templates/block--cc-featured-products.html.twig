{#
/**
 * @file
 * Template for the Featured Products block.
 */
#}
<div{{ attributes.addClass('cc-featured') }}>
  <div class="cc-featured__header">
    <h2 class="cc-featured__title">{{ 'Featured Products'|t }}</h2>
    <p class="cc-featured__subtitle">{{ 'Handpicked just for you'|t }}</p>
  </div>
  <div class="cc-featured__grid">
    {{ content }}
  </div>
  <div class="cc-featured__footer">
    <a href="/products" class="cc-featured__cta">{{ 'View All Products'|t }}</a>
  </div>
</div>
